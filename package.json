{
  "name": "nexora",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:start": "supabase start -x studio,imgproxy,edge-runtime,logflare,vector,supavisor,realtime,postgres-meta",
    "db:reset": "supabase db reset",
    "db:seed:generate": "node --no-warnings scripts/generate-seed.mjs",
    "db:types": "supabase gen types typescript --local > lib/supabase/database.types.ts",
    "videos:worker": "node --no-warnings --env-file-if-exists=.env.local videos/worker.ts",
    "videos:site": "node --no-warnings videos/site-videos.ts"
  },
  "dependencies": {
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "next": "^15.5.29",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "three": "^0.187.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "gsap": "^3.15.0",
    "postcss": "^8.5.33",
    "supabase": "^2.122.1",
    "tailwindcss": "^4.3.5",
    "typescript": "5.9"
  }
}
