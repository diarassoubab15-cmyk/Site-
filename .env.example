# URL publique du site (utilisée pour le SEO : canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://nexora.example

# Supabase (voir README, section « Brancher Supabase »)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé serveur : ne JAMAIS l'exposer côté navigateur
SUPABASE_SERVICE_ROLE_KEY=

# Seul compte autorisé à ouvrir /admin
ADMIN_EMAIL=

# Agrégateur de paiement pour les ABONNEMENTS (Orange Money, Wave, MTN, Moov, carte)
PAYMENT_PROVIDER=cinetpay
PAYMENT_API_KEY=
PAYMENT_SITE_ID=

# Envoi des e-mails transactionnels
EMAIL_API_KEY=
EMAIL_FROM=NEXORA <notifications@nexora.example>

# Verrou provisoire de /admin (avant Supabase). Sans ces deux variables, /admin est fermé en production.
ADMIN_USER=
ADMIN_PASSWORD=

# Contact de l'administrateur (affiché aux vendeurs pour le paiement des abonnements)
NEXT_PUBLIC_ADMIN_WHATSAPP=+22370000000
NEXT_PUBLIC_ADMIN_PHONE=+22370000000
NEXT_PUBLIC_ADMIN_PHONE_DISPLAY=+223 70 00 00 00
# Compte Orange Money qui reçoit les abonnements (côté serveur uniquement, montré au vendeur après contact)
ADMIN_ORANGE_MONEY_NUMBER=
ADMIN_ORANGE_MONEY_NAME=

# Vidéos de boutique (programme de fabrication, `npm run videos:worker`) :
# facultative — sans elle, le scénario est construit sans IA à partir de la description.
ANTHROPIC_API_KEY=

# Studio IA (forfait Ultra) : création d'images et de vidéos par IA.
#   higgsfield = service réel (clé et secret créés sur higgsfield.ai, avec des crédits) ; mock = tests uniquement.
AI_STUDIO_PROVIDER=
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
# Optionnel : autres modèles Higgsfield
HIGGSFIELD_IMAGE_MODEL=
HIGGSFIELD_VIDEO_MODEL=
