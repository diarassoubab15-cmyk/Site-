# URL publique du site (utilisée pour le SEO : canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://nexora.example

# Supabase (voir README, section « Brancher Supabase »)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé serveur : ne JAMAIS l'exposer côté navigateur
SUPABASE_SERVICE_ROLE_KEY=

# Seul compte autorisé à ouvrir /admin
ADMIN_EMAIL=

# Agrégateur de paiement pour les ABONNEMENTS (Orange Money, Wave, MTN, Moov, carte)
PAYMENT_PROVIDER=cinetpay
PAYMENT_API_KEY=
PAYMENT_SITE_ID=

# Envoi des e-mails transactionnels
EMAIL_API_KEY=
EMAIL_FROM=NEXORA <notifications@nexora.example>

# Verrou provisoire de /admin (avant Supabase). Sans ces deux variables, /admin est fermé en production.
ADMIN_USER=
ADMIN_PASSWORD=
